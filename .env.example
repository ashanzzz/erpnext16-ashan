# ==========================================
# ERPNext 16 & Unraid 环境变量模版 (.env.example)
# ==========================================

# 1. Unraid 服务器 SSH 配置
UNRAID_SSH_HOST=192.168.8.11
UNRAID_SSH_PORT=22
UNRAID_SSH_USER=root
UNRAID_SSH_PASSWORD=your_password_here

# Tailscale 远程备选地址
UNRAID_TAILSCALE_HOST=100.80.0.4
UNRAID_TAILSCALE_SSH_PORT=22
UNRAID_TAILSCALE_WEB=http://100.80.0.4/
UNRAID_TAILSCALE_WEB_ALT=http://100.80.0.4:33/

# 已废弃域名 (不支持 SSH)
UNRAID_DEPRECATED_DOMAIN=unraid.335356119.xyz

# 2. ERPNext 16 Web 配置
ERPNEXT_SITE_URL=http://192.168.8.11:6888
ERPNEXT_TAILSCALE_URL=http://100.80.0.4:6888/
ERPNEXT_SITE=site1.local
CONTAINER_NAME=erpnext16

# 3. API 与网关
UNRAID_GRAPHQL_URL=http://192.168.8.11/graphql
UNRAID_GRAPHQL_TAILSCALE_URL=http://100.80.0.4/graphql
UNRAIDCLAW_URL=http://192.168.8.11:9876
UNRAIDCLAW_TAILSCALE_URL=http://100.80.0.4:9876

# 4. 可选：仅供数据库诊断脚本使用（禁止提交真实密码）
ERPNEXT_DB_USER=erpnext16
ERPNEXT_DB_PASSWORD=your_database_password_here
ERPNEXT_DB_NAME=erpnext16

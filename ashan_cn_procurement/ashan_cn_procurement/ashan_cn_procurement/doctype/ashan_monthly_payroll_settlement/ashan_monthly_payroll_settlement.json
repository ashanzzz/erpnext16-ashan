{
 "name": "Ashan Monthly Payroll Settlement",
 "doctype": "DocType",
 "engine": "InnoDB",
 "module": "Ashan CN Procurement",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "track_changes": 1,
 "autoname": "format:{company}-{period_month}",
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "options": "Company",
   "label": "核算主体公司",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "period_month",
   "fieldtype": "Data",
   "label": "薪酬核算月份",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "核定锁定状态",
   "options": "草稿\n已核定锁定\n已归档发放",
   "default": "草稿",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "locked",
   "fieldtype": "Check",
   "label": "是否锁定",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "workflow_stage",
   "fieldtype": "Select",
   "label": "统一流程状态",
   "options": "草稿\n已计算\n凭证核验通过\n已封账\n解锁申请中\n已解锁",

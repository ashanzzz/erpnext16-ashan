  {
   "fieldname": "items",
   "fieldtype": "Table",
   "options": "Ashan Monthly Payroll Item",
   "label": "薪酬明细行"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Payroll Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Payroll Operator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0
  }
 ]
}

   "label": "公积金PDF解析总额",
   "read_only": 1
  },
  {
   "fieldname": "hf_verify_status",
   "fieldtype": "Select",
   "label": "公积金凭证核验状态",
   "options": "未上传\n核验一致\n金额不符\n已豁免",

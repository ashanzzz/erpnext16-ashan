   "label": "解锁申请人",
   "read_only": 1
  },
  {
   "fieldname": "unlock_requested_at",
   "fieldtype": "Datetime",
   "label": "解锁申请时间",
   "read_only": 1
  },
  {
   "fieldname": "unlock_request_reason",
   "fieldtype": "Small Text",
   "label": "解锁申请原因",
   "read_only": 1
  },
  {
   "fieldname": "unlocked_by",
   "fieldtype": "Data",
   "label": "解锁审批人",
   "read_only": 1
  },
  {
   "fieldname": "unlocked_at",
   "fieldtype": "Datetime",
   "label": "解锁审批时间",
   "read_only": 1
  },
  {
   "fieldname": "unlock_reason",
   "fieldtype": "Small Text",
   "label": "解锁审批说明",
   "read_only": 1
  },
  {
   "fieldname": "sb_vouchers",
   "fieldtype": "Section Break",
   "label": "原始单据与核验凭证"
  },
  {
   "fieldname": "imported_excel_file",
   "fieldtype": "Attach",
   "label": "车间实发表原件 (Excel)"
  },
  {
   "fieldname": "import_parser_version",
   "fieldtype": "Data",
   "label": "工资表解析器版本",
   "read_only": 1
  },
  {
   "fieldname": "import_schema_version",
   "fieldtype": "Data",
   "label": "识别的工资表结构",
   "read_only": 1
  },
  {
   "fieldname": "import_compatibility_score",
   "fieldtype": "Int",
   "label": "导入兼容度",
   "read_only": 1
  },
  {
   "fieldname": "import_file_sha256",
   "fieldtype": "Data",
   "label": "工资表文件SHA256",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "import_diagnostics",
   "fieldtype": "Small Text",
   "label": "导入诊断",
   "read_only": 1
  },
  {
   "fieldname": "ss_payment_file",
   "fieldtype": "Attach",
   "label": "社保缴费申报表原件 (PDF)"
  },
  {
   "fieldname": "ss_parsed_amount",
   "fieldtype": "Currency",
   "label": "社保PDF解析总额",
   "read_only": 1
  },
  {
   "fieldname": "ss_verify_status",
   "fieldtype": "Select",
   "label": "社保凭证核验状态",
   "options": "未上传\n核验一致\n金额不符\n已豁免",
   "default": "未上传"
  },
  {
   "fieldname": "cb_vouchers",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "hf_payment_file",
   "fieldtype": "Attach",
   "label": "公积金缴存凭证原件 (PDF)"
  },
  {
   "fieldname": "hf_parsed_amount",

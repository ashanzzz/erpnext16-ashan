{
  "name": "Qifu Employee Type Policy",
  "doctype": "DocType",
  "engine": "InnoDB",
  "module": "Ashan CN Procurement",
  "custom": 1,
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "autoname": "format:{company}-{employee_type}",
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "公司主体",
      "options": "Company",
      "reqd": 1,
      "default": "天津祺富机械加工有限公司",
      "in_standard_filter": 1
    },
    {
      "fieldname": "employee_type",
      "fieldtype": "Select",
      "label": "用工性质",
      "options": "正式工\n返聘工\n其他-返聘工\n其他-正式工\n临时工\n本月离职\n退休返聘\n外籍工\n实习生\n劳务派遣\n其他类型员工",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "category_group",
      "fieldtype": "Select",
      "label": "统计归类",
      "options": "正式工\n退休返聘人员\n临时工\n劳务派遣\n实习生\n其他类型员工\n离职人员",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "启用",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "sec_rules",
      "fieldtype": "Section Break",
      "label": "算薪与法定规则配置"
    },
    {
      "fieldname": "participate_tax",
      "fieldtype": "Check",
      "label": "计入个税计算",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "participate_social_security",
      "fieldtype": "Check",
      "label": "缴纳社会保险",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "col_rules",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "participate_housing_fund",
      "fieldtype": "Check",
      "label": "缴纳住房公积金",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "participate_payroll",
      "fieldtype": "Check",
      "label": "计入工资核定表",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "participate_workshop_roster",
      "fieldtype": "Check",
      "label": "计入车间实发表",
      "default": "1"
    },
    {
      "fieldname": "participate_cash_bills",
      "fieldtype": "Check",
      "label": "参与现金发放表",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "sec_descriptions",
      "fieldtype": "Section Break",
      "label": "规则详细说明"
    },
    {
      "fieldname": "tax_rule_description",
      "fieldtype": "Small Text",
      "label": "个税规则说明"
    },
    {
      "fieldname": "insurance_rule_description",
      "fieldtype": "Small Text",
      "label": "社保公积金规则说明"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "备注"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Payroll Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Payroll Operator",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "title_field": "employee_type",
  "show_title_field_in_link": 1,
  "search_fields": "employee_type,category_group",
  "sort_field": "creation",
  "sort_order": "ASC"
}
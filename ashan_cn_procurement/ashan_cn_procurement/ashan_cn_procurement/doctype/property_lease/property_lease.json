{
  "name": "Property Lease",
  "module": "Ashan CN Procurement",
  "doctype": "DocType",
  "custom": 0,
  "issingle": 0,
  "istable": 0,
  "autoname": "format:{company}-{property_name}",
  "title_field": "property_name",
  "search_fields": "company,property_name,supplier,location_address",
  "fields": [
    {
      "fieldtype": "Section Break",
      "label": "🏢 基础信息与不动产权属",
      "fieldname": "sb_base"
    },
    {
      "label": "场地/房间/仓库名称",
      "fieldname": "property_name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "description": "如: 仓库-930平米、空港厂房-3338平米、打磨车间"
    },
    {
      "label": "承租方/所属公司",
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1,
      "description": "购买方/承租公司，如: 天津吉众科技有限公司 / 天津祺富机械加工有限公司"
    },
    {
      "label": "出租方/业主",
      "fieldname": "supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "in_list_view": 1,
      "description": "销售方/房东公司，如: 圣凯（天津）工业有限公司"
    },
    {
      "label": "建筑/使用面积(㎡)",
      "fieldname": "area",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1,
      "description": "租赁实际面积（平方米），如 3338 或 930"
    },
    {
      "label": "押金/履约保证金(元)",
      "fieldname": "deposit_amount",
      "fieldtype": "Currency",
      "in_list_view": 1,
      "description": "如: 押一付三或固定押金 50,000 元"
    },
    {
      "fieldtype": "Column Break",
      "fieldname": "cb_lease_1"
    },
    {
      "label": "产权证书/不动产权证号",
      "fieldname": "property_certificate_no",
      "fieldtype": "Data",
      "description": "如发票备注中的产权证号: 115011400759"
    },
    {
      "label": "不动产地址/具体位置",
      "fieldname": "location_address",
      "fieldtype": "Data",
      "description": "如: 天津市东丽区空港经济区中环南路106号"
    },
    {
      "label": "租赁起日",
      "fieldname": "start_date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "label": "租赁止日",
      "fieldname": "end_date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "label": "启用",
      "fieldname": "enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldtype": "Section Break",
      "label": "💰 房租计费与单价 (支持按日/月/年单价或总额自选录入，自动互算)",
      "fieldname": "sb_rent"
    },
    {
      "label": "房租计价方式",
      "fieldname": "rent_pricing_mode",
      "fieldtype": "Select",
      "options": "按年总金额 (元/年)\n按日单价 (元/㎡·天)\n按年单价 (元/㎡·年)\n按月单价 (元/㎡·月)\n按月总金额 (元/月)",
      "default": "按年总金额 (元/年)",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "单价/金额是否含税",
      "fieldname": "is_tax_inclusive",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1,
      "description": "勾选为含税金额/单价，取消勾选为不含税金额/单价"
    },
    {
      "label": "房租税率(%)",
      "fieldname": "rent_tax_rate",
      "fieldtype": "Percent",
      "default": "5.0",
      "reqd": 1,
      "in_list_view": 1,
      "description": "不动产经营租赁服务税率，发票专票通常为 5%（简易征收）或 9%"
    },
    {
      "label": "房租含税日单价(元/㎡·天)",
      "fieldname": "rent_daily_rate",
      "fieldtype": "Float",
      "description": "如: 0.7875 元/㎡/天"
    },
    {
      "label": "房租含税年单价(元/㎡·年)",
      "fieldname": "rent_annual_rate",
      "fieldtype": "Float",
      "description": "如: 287.44 元/㎡/年"
    },
    {
      "label": "房租含税月单价(元/㎡·月)",
      "fieldname": "rent_monthly_rate",
      "fieldtype": "Float"
    },
    {
      "fieldtype": "Column Break",
      "fieldname": "cb_rent_rates"
    },
    {
      "label": "房租含税年金额(元/年)",
      "fieldname": "rent_annual_amount",
      "fieldtype": "Currency",
      "in_list_view": 1,
      "description": "如: 959,466.00 元/年"
    },
    {
      "label": "房租含税月金额(元/月)",
      "fieldname": "rent_monthly_amount",
      "fieldtype": "Currency"
    },
    {
      "label": "房租不含税年金额(元/年)",
      "fieldname": "rent_annual_tax_excl",
      "fieldtype": "Currency",
      "read_only": 1,
      "description": "如 5% 简易征收不含税额: 913,777.14 元"
    },
    {
      "label": "房租年税额(元/年)",
      "fieldname": "rent_annual_tax_amount",
      "fieldtype": "Currency",
      "read_only": 1,
      "description": "如 5% 专票税额: 45,688.86 元"
    },
    {
      "fieldtype": "Section Break",
      "label": "🛠️ 物业费计收与计价 (税率与房租独立，单独核算每天/每年每平米成本)",
      "fieldname": "sb_property_fee"
    },
    {
      "label": "物业费计收方式",
      "fieldname": "property_fee_mode",
      "fieldtype": "Select",
      "options": "免物业费\n单独计物业费",
      "default": "免物业费",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "物业费计价方式",
      "fieldname": "property_fee_pricing_mode",
      "fieldtype": "Select",
      "options": "按年单价 (元/㎡·年)\n按日单价 (元/㎡·天)\n按月单价 (元/㎡·月)\n按年总金额 (元/年)\n按月总金额 (元/月)",
      "default": "按年单价 (元/㎡·年)",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'"
    },
    {
      "label": "物业费是否含税",
      "fieldname": "property_fee_is_tax_inclusive",
      "fieldtype": "Check",
      "default": "1",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'"
    },
    {
      "label": "物业费税率(%)",
      "fieldname": "property_fee_tax_rate",
      "fieldtype": "Percent",
      "default": "6.0",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'",
      "description": "企业管理服务/物业服务发票税率，通常为 6% 或 3%"
    },
    {
      "label": "物业费含税日单价(元/㎡·天)",
      "fieldname": "property_fee_daily_rate",
      "fieldtype": "Float",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'",
      "description": "如: 0.0493 元/㎡/天"
    },
    {
      "label": "物业费含税年单价(元/㎡·年)",
      "fieldname": "property_fee_annual_rate",
      "fieldtype": "Float",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'",
      "description": "如: 18.00 元/㎡/年"
    },
    {
      "label": "物业费含税月单价(元/㎡·月)",
      "fieldname": "property_fee_monthly_rate",
      "fieldtype": "Float",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'"
    },
    {
      "fieldtype": "Column Break",
      "fieldname": "cb_prop_rates"
    },
    {
      "label": "物业费含税年金额(元/年)",
      "fieldname": "property_fee_annual_amount",
      "fieldtype": "Currency",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'",
      "description": "如: 60,084.00 元/年"
    },
    {
      "label": "物业费含税月金额(元/月)",
      "fieldname": "property_fee_monthly_amount",
      "fieldtype": "Currency",
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'"
    },
    {
      "label": "物业费不含税年金额(元/年)",
      "fieldname": "property_fee_annual_tax_excl",
      "fieldtype": "Currency",
      "read_only": 1,
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'",
      "description": "如 6% 税率不含税额: 56,683.02 元"
    },
    {
      "label": "物业费年税额(元/年)",
      "fieldname": "property_fee_annual_tax_amount",
      "fieldtype": "Currency",
      "read_only": 1,
      "depends_on": "eval:doc.property_fee_mode=='单独计物业费'",
      "description": "如 6% 专票税额: 3,400.98 元"
    },
    {
      "fieldtype": "Section Break",
      "label": "📊 综合场地成本透视 (房租 + 物业费总成本分析)",
      "fieldname": "sb_summary"
    },
    {
      "label": "综合日成本(元/㎡·天)",
      "fieldname": "total_daily_rate",
      "fieldtype": "Float",
      "read_only": 1,
      "description": "房租日单价 + 物业费日单价"
    },
    {
      "label": "综合年单价(元/㎡·年)",
      "fieldname": "total_annual_rate",
      "fieldtype": "Float",
      "read_only": 1,
      "description": "房租年单价 + 物业费年单价"
    },
    {
      "fieldtype": "Column Break",
      "fieldname": "cb_summary_col2"
    },
    {
      "label": "年度含税总开支(元/年)",
      "fieldname": "total_annual_amount",
      "fieldtype": "Currency",
      "read_only": 1,
      "in_list_view": 1,
      "description": "年度总支出: 房租 + 物业费"
    },
    {
      "label": "月度参考总开支(元/月)",
      "fieldname": "total_monthly_amount",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldtype": "Section Break",
      "label": "🧾 关联进项发票与开票对账 (5% 房租专票 ｜ 6% 物业专票)",
      "fieldname": "sb_invoices"
    },
    {
      "label": "本年租金减免/优惠金额(元)",
      "fieldname": "annual_discount_amount",
      "fieldtype": "Currency",
      "default": "0.0",
      "description": "如本年度园区补贴或疫情租金减免（平时为0）"
    },
    {
      "label": "开票对账状态",
      "fieldname": "invoice_status",
      "fieldtype": "Select",
      "options": "未开票\n部分开票\n全额已开票",
      "default": "未开票",
      "in_list_view": 1
    },
    {
      "label": "房租数电专票号码",
      "fieldname": "rent_invoice_no",
      "fieldtype": "Data",
      "description": "如: 25122000000068752502"
    },
    {
      "label": "房租开票日期",
      "fieldname": "rent_invoice_date",
      "fieldtype": "Date"
    },
    {
      "label": "房租已开票金额(含税)",
      "fieldname": "rent_invoice_amount",
      "fieldtype": "Currency"
    },
    {
      "label": "房租发票税额(5%)",
      "fieldname": "rent_invoice_tax",
      "fieldtype": "Currency"
    },
    {
      "fieldtype": "Column Break",
      "fieldname": "cb_inv_prop"
    },
    {
      "label": "物业费数电专票号码",
      "fieldname": "property_fee_invoice_no",
      "fieldtype": "Data",
      "description": "如: 25122000000068723440"
    },
    {
      "label": "物业费开票日期",
      "fieldname": "property_fee_invoice_date",
      "fieldtype": "Date"
    },
    {
      "label": "物业费已开票金额(含税)",
      "fieldname": "property_fee_invoice_amount",
      "fieldtype": "Currency"
    },
    {
      "label": "物业费发票税额(6%)",
      "fieldname": "property_fee_invoice_tax",
      "fieldtype": "Currency"
    },
    {
      "label": "备注说明",
      "fieldname": "remark",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Property Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "Property Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}

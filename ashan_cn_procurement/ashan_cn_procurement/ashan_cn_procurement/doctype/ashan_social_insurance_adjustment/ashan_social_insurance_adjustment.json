      "label": "证件号码",
      "read_only": 1
    },
    {
      "fieldname": "biz_type",
      "fieldtype": "Select",
      "label": "业务类型",
      "options": "历史补缴\n滞纳金/利息\n调基差额补退\n特殊补助",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "ss_base",
      "fieldtype": "Currency",
      "label": "调整社保基数"
    },
    {
      "fieldname": "comp_pension",
      "fieldtype": "Currency",
      "label": "单位养老",
      "read_only": 1
    },
    {
      "fieldname": "comp_unemp",
      "fieldtype": "Currency",
      "label": "单位失业",
      "read_only": 1
    },
    {
      "fieldname": "comp_med",
      "fieldtype": "Currency",
      "label": "单位医疗",
      "read_only": 1
    },
    {
      "fieldname": "comp_other_med",
      "fieldtype": "Currency",
      "label": "单位其他医疗",
      "read_only": 1
    },
    {
      "fieldname": "comp_injury",
      "fieldtype": "Currency",
      "label": "单位工伤",
      "read_only": 1
    },
    {
      "fieldname": "comp_total",
      "fieldtype": "Currency",
      "label": "单位合计",
      "read_only": 1
    },
    {
      "fieldname": "pers_pension",
      "fieldtype": "Currency",
      "label": "个人养老",
      "read_only": 1
    },
    {
      "fieldname": "pers_unemp",
      "fieldtype": "Currency",
      "label": "个人失业",
      "read_only": 1
    },
    {
      "fieldname": "pers_med",
      "fieldtype": "Currency",
      "label": "个人医疗",
      "read_only": 1
    },
    {
      "fieldname": "pers_large_med",
      "fieldtype": "Currency",
      "label": "个人大额医疗",
      "read_only": 1
    },
    {
      "fieldname": "pers_total",
      "fieldtype": "Currency",
      "label": "个人合计",
      "read_only": 1
    },
    {
      "fieldname": "late_fee",
      "fieldtype": "Currency",
      "label": "滞纳金/利息",
      "read_only": 0
    },
    {
      "fieldname": "grand_total",
      "fieldtype": "Currency",
      "label": "总计",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "备注"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,

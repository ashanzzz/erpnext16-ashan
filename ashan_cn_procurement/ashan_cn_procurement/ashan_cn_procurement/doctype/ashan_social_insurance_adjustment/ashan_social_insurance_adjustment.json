{
  "name": "Ashan Social Insurance Adjustment",
  "doctype": "DocType",
  "engine": "InnoDB",
  "module": "Ashan CN Procurement",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "autoname": "format:SSADJ-{YYYY}-{#####}",
  "title_field": "employee_name",
  "search_fields": "employee_no,employee_name,company,payroll_period,adjustment_period,biz_type",
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "公司",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "payroll_period",
      "fieldtype": "Data",
      "label": "计入薪酬账期",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "adjustment_period",
      "fieldtype": "Data",
      "label": "补缴/调整所属期",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "employee_no",
      "fieldtype": "Data",
      "label": "工号",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "姓名",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "employee_type",
      "fieldtype": "Data",
      "label": "用工性质",
      "read_only": 1
    },
    {
      "fieldname": "id_card",
